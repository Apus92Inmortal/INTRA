# Supabase public client configuration
# Get these values from Supabase Dashboard -> Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://okajyhkdyapbsornjeeb.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Wompi public key can be exposed to the browser; private/events/integrity keys are server-only.
# Current server-side names use the INTRA_ prefix. Legacy WOMPI_PRIVATE_KEY,
# WOMPI_EVENTS_KEY and WOMPI_INTEGRITY_KEY are not read by the app.
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=pub_test_xxx
INTRA_WOMPI_PRIVATE_KEY=prv_test_xxx
INTRA_WOMPI_EVENTS_KEY=test_events_xxx
INTRA_WOMPI_INTEGRITY_KEY=test_integrity_xxx
NEXT_PUBLIC_WOMPI_SANDBOX=true

# Server-only operational secrets. Never expose real values in the repo.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
ADMIN_USER_IDS=00000000-0000-0000-0000-000000000000
ADMIN_EMAILS=admin@example.com
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Vercel Cron sends this value as Authorization: Bearer <CRON_SECRET>.
# INTERNAL_CRON_SECRET is still accepted for manual/internal POST calls.
CRON_SECRET=generate_a_random_16_plus_character_secret
INTERNAL_CRON_SECRET=generate_a_random_16_plus_character_secret
